{
  "name": "bijoy-lenden",
  "version": "1.0.0",
  "private": true,
  "description": "বিজয় লেনদেন (Bijoy Lenden) — ব্যবসায়িক হিসাব ও লেনদেন ব্যবস্থাপনা",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env prisma/seed.ts",
    "db:studio": "prisma studio",
    "super-admin": "tsx --conditions=react-server --env-file-if-exists=.env scripts/super-admin.ts",
    "package:cpanel": "node scripts/package-cpanel.mjs",
    "test:mysql": "node scripts/test-mysql.mjs",
    "db:mysql:schema": "node scripts/mysql-schema.mjs && node scripts/mysql-migration.mjs",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "exceljs": "4.4.0",
    "jose": "6.2.12",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "deepmerge-ts": "^8.0.2",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
