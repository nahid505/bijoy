# ═══════════════════════════════════════════════════════════════════════════════════════════
# বিজয় লেনদেন — production environment for Recohost / cPanel ("Setup Node.js App")
#
# This is a TEMPLATE without real values. Never put real values in this file, never commit a real .env.
# On the server (application root, next to app.js):
#     cp env.production.example .env && chmod 600 .env        ← the package ships this file as env.production.example
# or enter the same NAME=value pairs in cPanel → Setup Node.js App → Environment variables
# (cPanel values win over .env). After a change: Setup Node.js App → Restart.
#
# Generate every secret ON THE SERVER (cPanel Terminal), one per variable:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
#   [REQUIRED]     the app does not work without it
#   [RECOMMENDED]  works without it, but a feature is off or less safe (check: node check-server.cjs)
#   [OPTIONAL]     only when you use that feature; leave empty otherwise
#
# Not used by this app (do not add): NEXTAUTH_SECRET / NEXTAUTH_URL / JWT_SECRET — sessions are signed with AUTH_SECRET.
# Set by app.js itself (do not add): NODE_ENV=production, NEXT_TELEMETRY_DISABLED=1, HOSTNAME.
# Set by cPanel (do not add): PORT.
# ═══════════════════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────── core ───────────────────────────────

# [REQUIRED] Database. The package from `npm run deploy:cpanel` is built for MySQL 8.0.16+ / MariaDB 10.6+.
#   Format: mysql://CPANELUSER_dbuser:PASSWORD@localhost:3306/CPANELUSER_dbname?connection_limit=5
#   - user and database names carry the cPanel prefix (cpuser_…), as shown in "MySQL® Databases"
#   - URL-encode special characters in the password: @ → %40   # → %23   : → %3A   / → %2F   ? → %3F   % → %25
#   - connection_limit=5 keeps shared hosting within its MySQL connection limit
#   (A package built with `-- --db=postgresql` takes postgresql://USER:PASSWORD@localhost:5432/DBNAME here.)
#   Missing → every page that reads data fails (500) and /api/health answers 503.
DATABASE_URL=

# [REQUIRED] Signs login sessions; also the fallback key for SMS key encryption and billing webhooks.
#   At least 32 random characters (use the command above). Changing it later signs everybody out.
#   Missing / short → login and registration fail.
AUTH_SECRET=

# [RECOMMENDED] Public address, https://, no trailing slash. Used for payment callbacks and links.
APP_URL=https://erp.example.com

# [RECOMMENDED] true when the site is served over HTTPS (cPanel AutoSSL / Let's Encrypt): Secure cookies + HSTS.
#   Keep false only while testing over plain http:// — with true, login does not work over http.
COOKIE_SECURE=true

# [RECOMMENDED] cPanel's Apache / LiteSpeed sits in front of the app → 1 (real client IP for login limits).
TRUSTED_PROXY_HOPS=1

# ─────────────────────────────── background jobs ───────────────────────────────

# [RECOMMENDED] Enables POST /api/cron/daily-check and /api/cron/sms-queue (Bearer token), used by cron.sh.
#   At least 16 characters. cPanel (Passenger) stops idle apps, so the cron jobs are the reliable trigger.
CRON_SECRET=
# [OPTIONAL] In-app scheduler as well (safe together with the cron jobs). true = off.
DISABLE_SCHEDULER=false
# [OPTIONAL] Defaults: daily check tick every 60 minutes, SMS queue every 15 seconds.
SCHEDULER_INTERVAL_MINUTES=60
SMS_QUEUE_INTERVAL_SECONDS=15

# ─────────────────────────────── registration ───────────────────────────────

# [OPTIONAL] false closes self sign-up (/register). Default: open.
REGISTRATION_ENABLED=true
# [OPTIONAL] Site-wide new accounts per hour (default 30); per IP / mobile it is always 5 per hour.
REGISTRATION_HOURLY_LIMIT=30
# [OPTIONAL] When SMS is configured, sign-up requires a mobile OTP. false turns the OTP off.
REGISTRATION_OTP=

# ─────────────────────────────── billing (SaaS subscriptions) ───────────────────────────────

# NEVER enable the mock gateway in production.
BILLING_MOCK=false
BILLING_MOCK_ALLOW_PRODUCTION=false
# [RECOMMENDED if you take payments] Verifies gateway webhooks — at least 32 characters (falls back to AUTH_SECRET).
BILLING_WEBHOOK_SECRET=
# Manual transfer: the customer pays to your bKash / Nagad / bank and submits the TrxID; Super Admin verifies.
BILLING_MANUAL=true
BILLING_MANUAL_INSTRUCTIONS=বিকাশ মার্চেন্ট 01XXXXXXXXX-এ "Payment" করুন, তারপর TrxID দিন।
# [OPTIONAL] bKash Tokenized Checkout — leave empty until bKash gives you merchant credentials.
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# ─────────────────────────────── SMS (optional) ───────────────────────────────

# Server-wide gateway for OTP codes (and businesses that pick the "platform" provider).
#   SMS_PROVIDER: bulksmsbd | http      (empty = no server SMS; businesses can still add their own gateway)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
# Only for SMS_PROVIDER=http: your gateway's endpoint (POST JSON with a Bearer token).
SMS_HTTP_URL=
# Only to override the BulkSMSBD address (default https://bulksmsbd.net).
SMS_BULKSMSBD_URL=
# Encrypts businesses' stored SMS API keys — at least 32 characters (falls back to AUTH_SECRET).
#   Set it once and keep it: changing it makes stored SMS keys unreadable (re-enter them).
SMS_ENCRYPTION_KEY=
# Delivery-report webhook token: /api/sms/dlr?token=…  (empty = webhook off)
SMS_WEBHOOK_SECRET=

# ─────────────────────────────── e-mail (optional) ───────────────────────────────

# log = only written to the app log | http = POST to EMAIL_HTTP_URL with EMAIL_HTTP_TOKEN
EMAIL_PROVIDER=log
EMAIL_HTTP_URL=
EMAIL_HTTP_TOKEN=
EMAIL_FROM=

# cPanel / standard SMTP credentials for password reset OTP
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ─────────────────────────────── invoice / website identity (optional) ───────────────────────────────

PLATFORM_NAME=বিজয় লেনদেন
PLATFORM_ADDRESS=
PLATFORM_BIN=
PLATFORM_SUPPORT_EMAIL=

# ─────────────────────────────── advanced (normally leave out) ───────────────────────────────

# Interface app.js listens on (default 127.0.0.1 — cPanel's proxy connects there). Do not change on cPanel.
# BIND_HOST=127.0.0.1
