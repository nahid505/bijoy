# ─────────────────────────────────────────────────────────────────────────────────────
# বিজয় লেনদেন — production environment for cPanel (RecoHost) Node.js hosting
#
# Copy to ".env" in the application root on the SERVER (never commit it, never upload it to GitHub):
#     cp env.production.example .env && chmod 600 .env
# or enter the same names/values in cPanel → Setup Node.js App → Environment variables.
# Generate every secret ON THE SERVER, e.g.:
#     node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# Database — this package is built for MySQL 8.0.16+ / MariaDB 10.6+ (cPanel "MySQL Databases").
#   mysql://CPANELUSER_dbuser:PASSWORD@localhost:3306/CPANELUSER_dbname?connection_limit=5
# Use a password made of letters and digits only (no @ : / ? # &), or URL-encode it.
# (A PostgreSQL package — npm run package:cpanel -- --db=postgresql — takes postgresql://… here.)
DATABASE_URL=

# At least 32 random characters. Changing it signs everybody out.
AUTH_SECRET=

# Public address with https:// (payment callbacks, links). No trailing slash.
APP_URL=https://erp.example.com
# HTTPS is on (cPanel AutoSSL / Let's Encrypt) → secure cookies + HSTS
COOKIE_SECURE=true
# cPanel's Apache/LiteSpeed sits in front of the app and sets X-Forwarded-For
TRUSTED_PROXY_HOPS=1

# Cron endpoints (/api/cron/daily-check, /api/cron/sms-queue) — at least 16 characters.
CRON_SECRET=
# The in-process scheduler stays on; the cPanel cron jobs are the reliable trigger (Passenger
# stops idle apps). Both are safe together.
DISABLE_SCHEDULER=false

# ── Billing ──
# NEVER enable the mock gateway in production.
BILLING_MOCK=false
BILLING_MOCK_ALLOW_PRODUCTION=false
# Verifies gateway webhooks — at least 32 characters.
BILLING_WEBHOOK_SECRET=
# Manual transfer (customer pays to your bKash/Nagad/bank and submits the TrxID; Super Admin verifies)
BILLING_MANUAL=true
BILLING_MANUAL_INSTRUCTIONS=বিকাশ মার্চেন্ট 01XXXXXXXXX-এ "Payment" করুন, তারপর TrxID দিন।
# bKash Tokenized Checkout (leave empty until bKash gives you merchant credentials)
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# ── SMS (optional) ──  bulksmsbd | http
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_ENCRYPTION_KEY=
SMS_WEBHOOK_SECRET=
REGISTRATION_OTP=

# ── E-mail (optional) ──  log | http
EMAIL_PROVIDER=log
EMAIL_HTTP_URL=
EMAIL_HTTP_TOKEN=
EMAIL_FROM=

# ── Invoice / website identity ──
PLATFORM_NAME=বিজয় লেনদেন
PLATFORM_ADDRESS=
PLATFORM_BIN=
PLATFORM_SUPPORT_PHONE=
PLATFORM_SUPPORT_EMAIL=
