# ------------------------------------------------------------
# বিজয় লেনদেন (Bijoy Lenden) — environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# cPanel / RecoHost (Node.js App, no Docker): use deploy/cpanel/env.production.example — see DEPLOY-RECOHOST.md
# ------------------------------------------------------------

# PostgreSQL (used by docker-compose to initialise the database)
POSTGRES_USER=bijoy
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=bijoy_lenden
# Host port the database is published on (change if 5432 is busy)
DB_PORT=5432

# Prisma connection string.
# Local dev (app on host, db in docker): host = 127.0.0.1 (not "localhost" —
# on Windows that may resolve to IPv6 ::1 while the DB is published on IPv4 only).
# Keep the port in sync with DB_PORT. Use a URL-safe password (letters, digits, - _).
# docker-compose overrides this automatically to use host "db".
DATABASE_URL=postgresql://bijoy:change-me-strong-db-password@127.0.0.1:5432/bijoy_lenden?schema=public
# MySQL 8.0.16+ / MariaDB 10.6+ instead (cPanel hosting) — needs the MySQL Prisma Client
# (npm run package:cpanel builds it; see FINAL-RECOHOST-DEPLOYMENT.md):
# DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DATABASE?connection_limit=5

# Optional: a disposable MySQL / MariaDB test database for "npm run test:mysql"
TEST_MYSQL_URL=

# Session signing secret — at least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Set to "true" only when served over HTTPS (secure cookies)
COOKIE_SECURE=false

# Initial administrator created by the seed script (only if no users exist)
SEED_ADMIN_NAME=অ্যাডমিন
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin-password
# Name of the first business created for the admin (optional)
SEED_BUSINESS_NAME=
# "true" creates a separate demo business with ~100 days of realistic Bangladeshi trading data
# (products, batch/expiry, credit customers, suppliers, POS split payments, returns, expenses),
# posted through the accounting engine. Skipped if a business with that name already exists.
SEED_DEMO_DATA=false
SEED_DEMO_BUSINESS_NAME=

# Separate database for integration tests (npm test). NEVER point this at real data.
# Create it once:  docker compose exec db createdb -U bijoy bijoy_lenden_test
TEST_DATABASE_URL=postgresql://bijoy:change-me-strong-db-password@127.0.0.1:5432/bijoy_lenden_test?schema=public

# Daily expiry / low-stock / overdue check. It runs inside the app process (also in Docker),
# hourly, and checks each business once per Asia/Dhaka day. Duplicate alerts are impossible.
DISABLE_SCHEDULER=false
SCHEDULER_INTERVAL_MINUTES=60
# Optional: lets an external cron trigger the check (POST /api/cron/daily-check with
# "Authorization: Bearer <CRON_SECRET>"). Leave empty to keep that endpoint disabled. Min 16 chars.
CRON_SECRET=

# ── SMS ───────────────────────────────────────────────────────────────────────────
# Platform gateway: used for security codes (registration / login / password-reset OTP, new-login
# alerts) and by businesses that choose "platform" in SMS settings. Empty = SMS codes disabled.
#   SMS_PROVIDER: bulksmsbd | http | mock   (mock = demo, nothing is really sent)
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=
# Key that encrypts the API keys businesses enter in SMS settings (min 32 chars). Defaults to a
# key derived from AUTH_SECRET. Changing it makes stored business API keys unreadable.
SMS_ENCRYPTION_KEY=
# Delivery-report callback: https://your.domain/api/sms/dlr?token=<SMS_WEBHOOK_SECRET>&provider=<id>
SMS_WEBHOOK_SECRET=
# Gateway endpoints (optional overrides)
SMS_BULKSMSBD_URL=
SMS_HTTP_URL=
SMS_QUEUE_INTERVAL_SECONDS=15
# "false" = do not require an SMS code at sign-up even when SMS is configured
REGISTRATION_OTP=

# Host port for the web app in docker-compose, and the interface it is published on.
# 127.0.0.1 = this machine only (default). Serve other devices through the HTTPS proxy below.
APP_PORT=3000
APP_BIND=127.0.0.1

# ── Production / HTTPS ──────────────────────────────────────────────────────────
# docker compose --profile https up -d   starts Caddy with automatic TLS certificates and HSTS.
# Then set: APP_DOMAIN=your.domain  COOKIE_SECURE=true  TRUSTED_PROXY_HOPS=1
APP_DOMAIN=
# Number of trusted reverse proxies in front of the app. Forwarded client addresses are ONLY
# used (audit log, per-address login limit) when this is > 0. Never set it without a proxy that
# overwrites X-Forwarded-For — otherwise clients could choose their own address.
TRUSTED_PROXY_HOPS=0

# ── SaaS: subscriptions & billing ──────────────────────────────────────────────────────
# Plans, prices, user limits, trial length, grace period, VAT and invoice prefix are configured in
# the database from the Super Admin panel (/admin). Grant Super Admin from the shell only:
#   npm run super-admin -- grant you@example.com
# Public base URL used in payment-gateway callback URLs (https://your.domain). Empty = request host.
APP_URL=
# Secret for verifying gateway webhooks / mock signatures (min 32 chars). Defaults to a key derived
# from AUTH_SECRET.
BILLING_WEBHOOK_SECRET=
# Mock gateway for local testing ONLY — refused in production unless BILLING_MOCK_ALLOW_PRODUCTION=true.
BILLING_MOCK=false
BILLING_MOCK_ALLOW_PRODUCTION=false
# Manual payment (customer sends bKash/Nagad/bank money and enters the TrxID; Super Admin verifies).
# "false" hides it. The instructions are shown on the manual-payment page (e.g. your merchant number).
BILLING_MANUAL=true
BILLING_MANUAL_INSTRUCTIONS=
# bKash Tokenized Checkout (merchant credentials from bKash). Sandbox base URL:
#   https://tokenized.sandbox.bka.sh/v1.2.0-beta   Leave empty to keep bKash disabled.
BKASH_BASE_URL=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Nagad and card gateways: adapters are placeholders — they stay disabled until implemented.

# ── Email (subscription / payment notices) ────────────────────────────────────────────
#   EMAIL_PROVIDER: log (default — written to the server log only) | http (POST JSON to EMAIL_HTTP_URL)
EMAIL_PROVIDER=log
EMAIL_HTTP_URL=
EMAIL_HTTP_TOKEN=
EMAIL_FROM=

# ── Platform identity (SaaS invoices, landing page contact) ──────────────────────────
PLATFORM_NAME=
PLATFORM_ADDRESS=
PLATFORM_BIN=
PLATFORM_SUPPORT_PHONE=
PLATFORM_SUPPORT_EMAIL=
