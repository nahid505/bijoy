// বিজয় লেনদেন (Bijoy Lenden) — double-entry accounting schema
//
// Accounting core:   AccountGroup → Account (= ledger) ← JournalEntry → Voucher (= journal)
// Inventory:         Product ← StockMovement → Warehouse, VoucherItem (inventory lines of a voucher)
// Tenancy:           every business row carries businessId; users join businesses via Membership.
//
// Money: Decimal(14,2) · Quantity: Decimal(14,3) · Unit factor: Decimal(14,6)

generator client {
  provider      = "prisma-client-js"
  // native = this machine; musl = Docker (Alpine); rhel = CloudLinux / cPanel (8: OpenSSL 1.1, 9: OpenSSL 3); debian = most VPS
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── enums ─────────────────────────────

enum AccountNature {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountKind {
  GENERAL
  CASH
  BANK
  CUSTOMER
  SUPPLIER
}

/// Accounting book. DEPOT (depot management) is kept completely apart from the business's GENERAL books:
/// every general report reads GENERAL entries only, the depot menu / reports read DEPOT entries.
enum Book {
  GENERAL
  DEPOT
}

enum VoucherType {
  OPENING
  RECEIPT
  PAYMENT
  JOURNAL
  SALES
  PURCHASE
  SALES_RETURN
  PURCHASE_RETURN
  STOCK_JOURNAL
  PRODUCTION
  DEPOT_DELIVERY // depot: delivery against a company DO (dealer paid the company) — stock out, commission due
}

enum StockMovementType {
  OPENING
  PURCHASE
  SALE
  SALES_RETURN
  PURCHASE_RETURN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  PRODUCTION_IN
  PRODUCTION_OUT
  DEPOT_OUT // depot delivery against a company DO
}

/// Depot delivery challan: how the dealer pays for the goods.
enum DepotDeliveryMode {
  COMPANY_PAID // "কোম্পানি পেইড (ডিও রিলিজ)": dealer paid the company; depot earns commission
  DEPOT_COLLECTION // "ডিপো কালেকশন (মার্কেট সেলস)": depot sells to the dealer (cash or market due)
}

enum NotificationKind {
  EXPIRED
  EXPIRY_WARNING
  LOW_STOCK
  OVERDUE
  SMS_BALANCE_LOW
  SUBSCRIPTION_EXPIRING
  SUBSCRIPTION_EXPIRED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PLAN_CHANGED
  USER_ADDED
  FEATURE_CHANGED
  TRIAL_STARTED
  SUBSCRIPTION_ACTIVATED
}

enum SmsStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  FAILED
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
  PASSWORD_RESET
}

enum NotificationSeverity {
  CRITICAL
  WARNING
  INFO
}

// ───────────────────────────── tenancy & access ─────────────────────────────

model Business {
  id                   String    @id @default(cuid())
  name                 String
  businessType         String? // retail, wholesale, pharmacy … (registration)
  logo                 String? // small image as data URL
  address              String?
  mobile               String?
  email                String?
  binNumber            String? // VAT Business Identification Number
  tinNumber            String? // Taxpayer Identification Number
  tradeLicense         String?
  currency             String    @default("BDT")
  currencySymbol       String    @default("৳")
  fiscalYearStartMonth Int       @default(7) // Bangladesh: July–June
  booksStartDate       DateTime // opening balances are dated on this day
  invoicePrefix        String    @default("INV")
  defaultVatPercent    Decimal   @default(0) @db.Decimal(5, 2)
  invoiceFooter        String?   @default("আমাদের সাথে ব্যবসা করার জন্য ধন্যবাদ।")
  invoiceTerms         String?
  lockDate             DateTime? // books closed: vouchers dated on/before this day cannot be created, edited or deleted
  expiryWarningDays    Int[]     @default([60, 30, 15, 7]) // expiry warning thresholds (days before expiry)
  allowExpiredSale     Boolean   @default(false) // false: expired batches cannot be sold
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  memberships         Membership[]
  userCustomers       UserCustomer[]
  userSuppliers       UserSupplier[]
  userAccounts        UserAccount[]
  roles               Role[]
  accountGroups       AccountGroup[]
  accounts            Account[]
  vouchers            Voucher[]
  journalEntries      JournalEntry[]
  customers           Customer[]
  suppliers           Supplier[]
  products            Product[]
  categories          Category[]
  brands              Brand[]
  units               Unit[]
  warehouses          Warehouse[]
  stockMovements      StockMovement[]
  auditLogs           AuditLog[]
  counters            Counter[]
  productBatches      ProductBatch[]
  notifications       Notification[]
  jobRuns             JobRun[]
  smsSettings         SmsSettings?
  smsTemplates        SmsTemplate[]
  smsMessages         SmsMessage[]
  payrollSettings     PayrollSettings?
  departments         Department[]
  employees           Employee[]
  payComponents       PayComponent[]
  payrollRuns         PayrollRun[]
  features            BusinessFeature[]
  featureLogs         FeatureActivationLog[]
  subscription        Subscription?
  paymentTransactions PaymentTransaction[]
  saasInvoices        Invoice[]
  recipes             Recipe[]
  productionRuns      ProductionRun[]
  paddyPurchases      PaddyPurchase[]
  depotDeliveries     DepotDelivery[]
}

model User {
  id                String    @id @default(cuid())
  isSuperAdmin      Boolean   @default(false) // platform operator (Super Admin panel); not tied to a business
  name              String
  email             String?   @unique // optional for self-registered accounts (they sign in with their mobile)
  mobile            String?   @unique // normalised Bangladeshi mobile: 01XXXXXXXXX
  passwordHash      String
  loginOtpEnabled   Boolean   @default(false) // second step: SMS code after the password
  loginAlertEnabled Boolean   @default(true) // SMS when a new session starts
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  memberships       Membership[]
  assignedCustomers UserCustomer[]
  assignedSuppliers UserSupplier[]
  assignedAccounts  UserAccount[]
  auditLogs         AuditLog[]
  notificationReads NotificationRead[]
  sessions          Session[]
  smsReceived       SmsMessage[]       @relation("SmsUser")
  smsCreated        SmsMessage[]       @relation("SmsCreatedBy")
  vouchersCreated   Voucher[]          @relation("VoucherCreatedBy")
  vouchersUpdated   Voucher[]          @relation("VoucherUpdatedBy")
}

// Permissions are string keys (see src/lib/permissions.ts); "*" = everything.
model Role {
  id          String       @id @default(cuid())
  businessId  String
  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  permissions String[]
  isSystem    Boolean      @default(false) // Owner role: immutable
  memberships Membership[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([businessId, name])
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  roleId     String
  role       Role     @relation(fields: [roleId], references: [id])
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
  @@index([businessId])
}

// Party restriction (row-level): a member whose role holds "customers:assigned_only" / "suppliers:assigned_only"
// sees only the customers / suppliers assigned here (lists, vouchers, ledgers, reports). See src/server/party-scope.ts.
model UserCustomer {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, customerId])
  @@index([businessId, userId])
}

/// Account-head restriction: a member whose role holds "accounts:assigned_only" sees only these ledgers
/// (cash, bank, income, expense … — party ledgers follow the customer / supplier restriction).
model UserAccount {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, accountId])
  @@index([businessId, userId])
}

model UserSupplier {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, supplierId])
  @@index([businessId, userId])
}

// ───────────────────────────── chart of accounts ─────────────────────────────

model AccountGroup {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  nature      AccountNature
  isDirect    Boolean        @default(false) // trading section of P&L (sales / cost of sales)
  systemKey   String? // stable key for built-in groups, e.g. SUNDRY_DEBTORS
  sortOrder   Int            @default(0)
  /// optional parent: a user sub-group shares its parent's nature and P&L section
  parentId    String?
  parent      AccountGroup?  @relation("GroupTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    AccountGroup[] @relation("GroupTree")
  description String?
  accounts    Account[]
  createdAt   DateTime       @default(now())

  @@unique([businessId, systemKey])
  @@unique([businessId, name])
  @@index([parentId])
}

/// A ledger. Balance = Σ debit − Σ credit of its journal entries (opening balance is an OPENING voucher).
model Account {
  id            String        @id @default(cuid())
  businessId    String
  business      Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  groupId       String
  group         AccountGroup  @relation(fields: [groupId], references: [id])
  name          String
  code          String?
  nature        AccountNature // copied from group for fast reporting
  kind          AccountKind   @default(GENERAL)
  systemKey     String? // CASH, INVENTORY, SALES, COGS, ...
  isSystem      Boolean       @default(false)
  isActive      Boolean       @default(true)
  description   String?
  bankName      String?
  accountNumber String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  assignedTo             UserAccount[]
  entries                JournalEntry[]
  customer               Customer?
  supplier               Supplier?
  partyVouchers          Voucher[]         @relation("VoucherParty")
  voucherPayments        VoucherPayment[]
  cashVouchers           Voucher[]         @relation("VoucherCash")
  adjustmentVouchers     Voucher[]         @relation("VoucherAdjustment")
  notifications          Notification[]
  payrollPayableFor      PayrollSettings[] @relation("PayrollPayableAccount")
  payrollAdvanceFor      PayrollSettings[] @relation("PayrollAdvanceAccount")
  payComponents          PayComponent[]    @relation("PayComponentAccount")
  payComponentsLiab      PayComponent[]    @relation("PayComponentLiability")
  depotCompanyDeliveries DepotDelivery[]   @relation("DepotCompany")
  depotDealerDeliveries  DepotDelivery[]   @relation("DepotDealer")
  payslipLines           PayslipLine[]     @relation("PayslipLineAccount")
  payslipLinesLiab       PayslipLine[]     @relation("PayslipLineLiability")

  @@unique([businessId, systemKey])
  @@unique([businessId, code])
  @@index([businessId, kind])
  @@index([businessId, groupId])
}

// ───────────────────────────── vouchers & journal ─────────────────────────────

/// A journal: the header of a balanced set of journal entries.
model Voucher {
  id                  String      @id @default(cuid())
  businessId          String
  business            Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type                VoucherType
  book                Book        @default(GENERAL)
  voucherNo           String
  date                DateTime
  reference           String?
  narration           String?
  partyAccountId      String? // customer / supplier ledger
  partyAccount        Account?    @relation("VoucherParty", fields: [partyAccountId], references: [id])
  cashAccountId       String? // cash / bank ledger used for payment
  cashAccount         Account?    @relation("VoucherCash", fields: [cashAccountId], references: [id])
  warehouseId         String?
  warehouse           Warehouse?  @relation(fields: [warehouseId], references: [id])
  subtotal            Decimal     @default(0) @db.Decimal(14, 2)
  discount            Decimal     @default(0) @db.Decimal(14, 2)
  vatPercent          Decimal     @default(0) @db.Decimal(5, 2)
  vatAmount           Decimal     @default(0) @db.Decimal(14, 2)
  amount              Decimal     @db.Decimal(14, 2) // voucher total (= Σ debit)
  paidAmount          Decimal     @default(0) @db.Decimal(14, 2) // paid / received at voucher time
  sourceKey           String? // unique link for system vouchers, e.g. "opening:account:<id>"
  dueDate             DateTime? // credit sales / purchases: payment due on
  returnOfId          String? // sales / purchase return: the original invoice
  returnOf            Voucher?    @relation("VoucherReturn", fields: [returnOfId], references: [id])
  returns             Voucher[]   @relation("VoucherReturn")
  adjustmentAccountId String? // stock journal: ledger for the value difference (default: STOCK_ADJUSTMENT; expiry write-off: EXPIRY_LOSS)
  adjustmentAccount   Account?    @relation("VoucherAdjustment", fields: [adjustmentAccountId], references: [id])
  createdById         String
  createdBy           User        @relation("VoucherCreatedBy", fields: [createdById], references: [id])
  updatedById         String?
  updatedBy           User?       @relation("VoucherUpdatedBy", fields: [updatedById], references: [id])
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  entries        JournalEntry[]
  items          VoucherItem[]
  productionRun  ProductionRun?
  paddyPurchase  PaddyPurchase?
  depotDelivery  DepotDelivery?
  payments       VoucherPayment[]
  stockMovements StockMovement[]
  smsMessages    SmsMessage[]
  payrollRun     PayrollRun?      @relation("PayrollRunVoucher")
  advance        EmployeeAdvance? @relation("PayrollAdvanceVoucher")
  salaryPayments SalaryPayment[]  @relation("SalaryPaymentVoucher")

  @@unique([businessId, voucherNo])
  @@unique([businessId, sourceKey])
  @@index([businessId, type, date])
  @@index([businessId, date])
  @@index([partyAccountId])
  @@index([returnOfId])
}

/// Settlement of a sales / purchase / return voucher through one or more cash / bank ledgers
/// (split payments: cash + bKash + bank …).
model VoucherPayment {
  id        String  @id @default(cuid())
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  amount    Decimal @db.Decimal(14, 2)
  reference String?
  lineNo    Int     @default(0)

  @@index([voucherId])
  @@index([accountId])
}

model JournalEntry {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  voucherId  String
  voucher    Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id])
  date       DateTime // copy of voucher date for fast ledger queries
  debit      Decimal  @default(0) @db.Decimal(14, 2)
  credit     Decimal  @default(0) @db.Decimal(14, 2)
  narration  String?
  lineNo     Int      @default(0)
  /// copy of the voucher's book (general reports filter on it)
  book       Book     @default(GENERAL)

  @@index([businessId, accountId, date])
  @@index([businessId, date])
  @@index([businessId, book, date])
  @@index([voucherId])
}

/// Inventory line of a sales / purchase / return / stock-journal voucher.
model VoucherItem {
  id             String          @id @default(cuid())
  voucherId      String
  voucher        Voucher         @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  productId      String
  product        Product         @relation(fields: [productId], references: [id])
  warehouseId    String?
  warehouse      Warehouse?      @relation(fields: [warehouseId], references: [id])
  unitId         String?
  unit           Unit?           @relation(fields: [unitId], references: [id])
  unitFactor     Decimal         @default(1) @db.Decimal(14, 6) // entered unit → base unit
  quantity       Decimal         @db.Decimal(14, 3) // in entered unit
  baseQuantity   Decimal         @db.Decimal(14, 3) // in product base unit
  /// free / scheme quantity (entered unit) on top of quantity: moves stock (quantity + free) but is never billed
  freeQuantity   Decimal         @default(0) @db.Decimal(14, 3)
  /// depot delivery: the rate printed on the dealer challan (the product's purchase price at delivery); null = not a depot line
  challanRate    Decimal?        @db.Decimal(14, 2)
  rate           Decimal         @db.Decimal(14, 2) // per entered unit
  discount       Decimal         @default(0) @db.Decimal(14, 2)
  amount         Decimal         @db.Decimal(14, 2) // quantity × rate − discount
  costRate       Decimal         @default(0) @db.Decimal(14, 4) // average cost per base unit at posting
  costAmount     Decimal         @default(0) @db.Decimal(14, 2)
  direction      Int             @default(0) // stock journal / production: +1 in, −1 out
  costShare      Decimal?        @db.Decimal(7, 4) // production output: % of the run's total cost
  batchNo        String? // set when the line uses exactly one batch (FEFO lines may span several — see its movements)
  expiryDate     DateTime?
  batchId        String?
  batch          ProductBatch?   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  stockMovements StockMovement[]
  lineNo         Int             @default(0)

  @@index([voucherId])
  @@index([productId])
  @@index([batchId])
}

// ───────────────────────────── parties ─────────────────────────────

model Customer {
  id            String         @id @default(cuid())
  businessId    String
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountId     String         @unique
  account       Account        @relation(fields: [accountId], references: [id])
  name          String
  mobile        String?
  email         String?
  address       String?
  notes         String?
  creditLimit   Decimal        @default(0) @db.Decimal(14, 2) // 0 = no limit
  creditDays    Int            @default(0) // payment terms: invoice due = date + creditDays
  groupName     String? // customer group (e.g. "পাইকারি", "এলাকা: মিরপুর") — used for group SMS
  route         String? // depot: dealer's route / area (market dues by route)
  /// depot dealer: kept out of the general customer list / pickers; their trade lives in the DEPOT book
  isDepotDealer Boolean        @default(false)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  smsMessages   SmsMessage[]
  assignedTo    UserCustomer[]

  @@index([businessId, name])
  @@index([businessId, mobile])
  @@index([businessId, groupName])
}

model Supplier {
  id          String         @id @default(cuid())
  businessId  String
  business    Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  accountId   String         @unique
  account     Account        @relation(fields: [accountId], references: [id])
  name        String
  mobile      String?
  email       String?
  address     String?
  notes       String?
  creditDays  Int            @default(0)
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  batches     ProductBatch[]
  smsMessages SmsMessage[]
  assignedTo  UserSupplier[]

  @@index([businessId, name])
  @@index([businessId, mobile])
}

// ───────────────────────────── inventory ─────────────────────────────

model Category {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  products   Product[]

  @@unique([businessId, name])
}

model Brand {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  products   Product[]

  @@unique([businessId, name])
}

/// Units. Alternative units point to a base unit: 1 বস্তা = 50 কেজি → (বস্তা, base=কেজি, factor=50).
model Unit {
  id           String        @id @default(cuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  baseUnitId   String?
  baseUnit     Unit?         @relation("UnitBase", fields: [baseUnitId], references: [id])
  derivedUnits Unit[]        @relation("UnitBase")
  factor       Decimal       @default(1) @db.Decimal(14, 6)
  products     Product[]
  voucherItems VoucherItem[]

  @@unique([businessId, name])
}

model Warehouse {
  id             String          @id @default(cuid())
  businessId     String
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  address        String?
  isDefault      Boolean         @default(false)
  stockMovements StockMovement[]
  vouchers       Voucher[]
  voucherItems   VoucherItem[]

  @@unique([businessId, name])
}

model Product {
  id                  String    @id @default(cuid())
  businessId          String
  business            Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                String
  code                String?
  barcode             String?
  categoryId          String?
  category            Category? @relation(fields: [categoryId], references: [id])
  brandId             String?
  brand               Brand?    @relation(fields: [brandId], references: [id])
  unitId              String
  unit                Unit      @relation(fields: [unitId], references: [id])
  purchasePrice       Decimal   @default(0) @db.Decimal(14, 2) // last purchase rate (base unit)
  salePrice           Decimal   @default(0) @db.Decimal(14, 2)
  /// depot: commission the company pays per base unit delivered against its DO
  depotCommissionRate Decimal   @default(0) @db.Decimal(14, 4)
  wholesalePrice      Decimal   @default(0) @db.Decimal(14, 2)
  minStock            Decimal   @default(0) @db.Decimal(14, 3)
  openingStock        Decimal   @default(0) @db.Decimal(14, 3)
  openingRate         Decimal   @default(0) @db.Decimal(14, 2)
  stock               Decimal   @default(0) @db.Decimal(14, 3) // cached Σ movements (base unit)
  avgCost             Decimal   @default(0) @db.Decimal(14, 4) // cached moving weighted-average cost
  trackBatch          Boolean   @default(false) // batch / expiry tracking
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  stockMovements StockMovement[]
  voucherItems   VoucherItem[]
  batches        ProductBatch[]
  notifications  Notification[]
  recipeLines    RecipeLine[]

  @@unique([businessId, code])
  @@unique([businessId, barcode])
  @@index([businessId, name])
  @@index([businessId, categoryId])
}

model StockMovement {
  id            String            @id @default(cuid())
  businessId    String
  business      Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId     String
  product       Product           @relation(fields: [productId], references: [id])
  warehouseId   String
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  voucherId     String?
  voucher       Voucher?          @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  voucherItemId String?
  voucherItem   VoucherItem?      @relation(fields: [voucherItemId], references: [id], onDelete: Cascade)
  batchNo       String?
  expiryDate    DateTime?
  batchId       String?
  batch         ProductBatch?     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  type          StockMovementType
  date          DateTime
  quantityIn    Decimal           @default(0) @db.Decimal(14, 3)
  quantityOut   Decimal           @default(0) @db.Decimal(14, 3)
  unitCost      Decimal           @default(0) @db.Decimal(14, 4)
  value         Decimal           @default(0) @db.Decimal(14, 2)
  createdAt     DateTime          @default(now())

  @@index([businessId, productId, date])
  @@index([businessId, warehouseId])
  @@index([voucherItemId])
  @@index([businessId, productId, batchNo])
  @@index([voucherId])
  @@index([batchId])
}

/// A batch / lot of a batch-tracked product. One product can have many batches with different
/// expiry dates. Quantities are derived from StockMovement (cached in `quantity`, all warehouses).
model ProductBatch {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  batchNo       String
  mfgDate       DateTime?
  expiryDate    DateTime?
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  purchaseDate  DateTime? // first receipt of the batch
  purchasePrice Decimal   @default(0) @db.Decimal(14, 4) // cost per base unit at first receipt
  salePrice     Decimal   @default(0) @db.Decimal(14, 2)
  quantity      Decimal   @default(0) @db.Decimal(14, 3) // cached on hand (base unit)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  stockMovements StockMovement[]
  voucherItems   VoucherItem[]
  notifications  Notification[]

  @@unique([productId, batchNo])
  @@index([businessId, expiryDate])
  @@index([businessId, quantity])
}

// ───────────────────────────── system ─────────────────────────────

model AuditLog {
  id         String    @id @default(cuid())
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | LOGIN_FAILED
  entity     String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([businessId, createdAt])
  @@index([entity])
  @@index([userId])
}

/// Gap-free document sequences per business (RV-000001, INV-000001, ...)
model Counter {
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  key        String
  value      Int      @default(0)

  @@id([businessId, key])
}

/// Alerts (expiry, low stock, overdue dues). Rows are history: reading never deletes them;
/// `resolvedAt` is set when the condition no longer applies. `dedupeKey` prevents duplicates.
model Notification {
  id         String               @id @default(cuid())
  businessId String
  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       NotificationKind
  severity   NotificationSeverity
  dedupeKey  String
  title      String
  message    String
  link       String?
  productId  String?
  product    Product?             @relation(fields: [productId], references: [id], onDelete: Cascade)
  batchId    String?
  batch      ProductBatch?        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  accountId  String?
  account    Account?             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  level      Int? // expiry: warning threshold in days (0 = today / expired)
  quantity   Decimal?             @db.Decimal(14, 3)
  amount     Decimal?             @db.Decimal(14, 2)
  dueOn      DateTime? // expiry date / invoice due date
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  resolvedAt DateTime?
  reads      NotificationRead[]

  @@unique([businessId, dedupeKey])
  @@index([businessId, resolvedAt, createdAt])
  @@index([businessId, kind])
  @@index([batchId])
}

model NotificationRead {
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@id([notificationId, userId])
  @@index([userId])
}

/// One row per scheduled job run per business and (Asia/Dhaka) day — makes the daily check idempotent.
model JobRun {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  job        String
  runOn      DateTime // calendar day (UTC midnight)
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  result     Json?

  @@unique([businessId, job, runOn])
}

/// Named, transaction-scoped locks on MySQL (PostgreSQL uses advisory locks; the table stays empty there).
/// See lockKey() in src/lib/dialect.ts.
model AppLock {
  key String @id
}

/// One row per login. The session cookie (a signed JWT) carries this id; a request is only
/// authenticated while the row exists, is not revoked and not expired — so logout revokes one
/// session and a password change / reset revokes all of them immediately.
model Session {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

/// Login throttling, shared by every app instance. key = "account:<email>" (independent of the
/// client address, so spoofed X-Forwarded-For headers cannot reset it) or "ip:<address>" (only
/// when the address comes from a trusted proxy). Attempts are counted before the password check.
model AuthThrottle {
  key         String    @id
  attempts    Int       @default(0)
  windowStart DateTime
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// ───────────────────────────── SMS ─────────────────────────────

/// Per-business SMS configuration. The API key is stored encrypted (AES-256-GCM, key from the
/// server environment) and is never sent to the browser — only `apiKeyHint` (last 4 chars).
/// provider "platform" = use the credentials configured on the server (SMS_* env variables).
model SmsSettings {
  businessId           String    @id
  business             Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabled              Boolean   @default(false)
  provider             String    @default("platform")
  apiKeyEnc            String?
  apiKeyHint           String?
  senderId             String?
  lowBalanceThreshold  Decimal   @default(100) @db.Decimal(12, 2)
  balance              Decimal?  @db.Decimal(12, 2)
  balanceCheckedAt     DateTime?
  events               String[]  @default(["SALE_INVOICE", "PAYMENT_RECEIVED", "SALES_RETURN", "INVOICE_CANCELLED", "DUE_REMINDER", "PURCHASE", "SUPPLIER_PAYMENT", "PURCHASE_RETURN", "LOW_STOCK", "EXPIRY_WARNING", "EXPIRED"])
  alertMobiles         String[]  @default([]) // inventory alerts go here (default: business mobile)
  expiryAlertDays      Int[]     @default([90, 60, 30, 15, 7])
  dueReminderEveryDays Int       @default(7)
  updatedAt            DateTime  @updatedAt
}

/// Admin-edited message templates; events without a row use the built-in default text.
model SmsTemplate {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  event      String
  body       String
  updatedAt  DateTime @updatedAt

  @@unique([businessId, event])
}

/// Every SMS: the queue item AND its permanent log. `dedupeKey` (unique) makes accidental
/// duplicates impossible; workers claim rows with FOR UPDATE SKIP LOCKED.
model SmsMessage {
  id            String    @id @default(cuid())
  businessId    String?
  business      Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  event         String
  recipient     String
  body          String
  encoding      String // GSM7 | UCS2
  parts         Int
  status        SmsStatus @default(QUEUED)
  priority      Int       @default(0)
  dedupeKey     String?   @unique
  provider      String?
  requestId     String?
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  nextAttemptAt DateTime  @default(now())
  lastError     String?
  cost          Decimal?  @db.Decimal(10, 4)
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  voucherId     String?
  voucher       Voucher?  @relation(fields: [voucherId], references: [id], onDelete: SetNull)
  voucherNo     String? // kept when the voucher is later deleted (cancellation)
  userId        String?
  user          User?     @relation("SmsUser", fields: [userId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?     @relation("SmsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  batchId       String? // bulk send
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
  deliveredAt   DateTime?
  failedAt      DateTime?
  updatedAt     DateTime  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([businessId, createdAt])
  @@index([businessId, status])
  @@index([provider, requestId])
  @@index([customerId])
}

/// One-time codes. Only an HMAC of the code is stored; codes expire, allow few attempts and can
/// be used once.
model SmsOtp {
  id          String     @id @default(cuid())
  purpose     OtpPurpose
  mobile      String
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?
  ipAddress   String?
  createdAt   DateTime   @default(now())

  @@index([mobile, purpose, createdAt])
}

// ───────────────────────── Payroll ─────────────────────────
// Employees, salary structures, attendance and monthly payroll. Money only reaches the books through
// vouchers of the existing accounting engine (sourceKey "payroll:…"): posting a payroll run, paying
// salaries and giving advances each create a balanced voucher.

enum EmploymentStatus {
  ACTIVE
  PROBATION
  ON_LEAVE
  RESIGNED
  TERMINATED
}

enum PayComponentKind {
  EARNING // part of gross salary (Dr expense)
  DEDUCTION // reduces net salary (Cr the component ledger)
  EMPLOYER // employer contribution, e.g. PF employer share, gratuity provision (Dr expense, Cr liability; not paid in net)
}

enum PayCalcType {
  FIXED
  PERCENT_OF_BASIC
  PERCENT_OF_GROSS
  RULE // computed by a registered rule (e.g. a tax slab), see src/lib/payroll.ts
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEAVE // paid leave
  UNPAID_LEAVE
  HALF_DAY
  HOLIDAY
}

enum PayrollKind {
  REGULAR // monthly salary
  BONUS // festival bonus run (Bangladesh: two per year)
}

enum PayrollStatus {
  DRAFT // calculated, under review: may be recalculated or deleted
  POSTED // finalized: posted to the books and locked
}

enum AdvanceKind {
  ADVANCE
  LOAN
}

model PayrollSettings {
  businessId             String   @id
  business               Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workingDaysMode        String   @default("FIXED") // FIXED | CALENDAR | CALENDAR_LESS_OFF_DAYS
  fixedWorkingDays       Int      @default(26)
  weeklyOffDays          Int[]    @default([5]) // 0 = Sunday … 6 = Saturday (Bangladesh: Friday)
  hoursPerDay            Decimal  @default(8) @db.Decimal(5, 2)
  overtimeMultiplier     Decimal  @default(2) @db.Decimal(5, 2) // Bangladesh Labour Act: twice the ordinary basic rate
  lateDaysPerAbsence     Int      @default(3) // this many late days = one day of deduction (0 = no deduction)
  absenceBasis           String   @default("BASIC") // BASIC | GROSS: salary a day of absence is deducted from
  salaryPayableAccountId String?
  salaryPayableAccount   Account? @relation("PayrollPayableAccount", fields: [salaryPayableAccountId], references: [id])
  advanceAccountId       String?
  advanceAccount         Account? @relation("PayrollAdvanceAccount", fields: [advanceAccountId], references: [id])
  updatedAt              DateTime @updatedAt
}

model Department {
  id         String     @id @default(cuid())
  businessId String
  business   Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  employees  Employee[]

  @@unique([businessId, name])
}

model Employee {
  id               String                    @id @default(cuid())
  businessId       String
  business         Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  code             String // employee ID, e.g. EMP-0001 (unique per business)
  name             String
  mobile           String?
  email            String?
  address          String?
  nid              String?
  tin              String?
  departmentId     String?
  department       Department?               @relation(fields: [departmentId], references: [id])
  designation      String?
  joiningDate      DateTime
  exitDate         DateTime?
  status           EmploymentStatus          @default(ACTIVE)
  basicSalary      Decimal                   @default(0) @db.Decimal(14, 2) // monthly
  overtimeEligible Boolean                   @default(true)
  overtimeRate     Decimal?                  @db.Decimal(14, 2) // per hour; empty = basic / (working days x hours) x multiplier
  paymentMethod    String? // CASH | BANK | MOBILE
  bankName         String?
  bankAccountNo    String?
  notes            String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  components       EmployeeSalaryComponent[]
  revisions        SalaryRevision[]
  attendances      Attendance[]
  payslips         Payslip[]
  advances         EmployeeAdvance[]
  payments         SalaryPayment[]

  @@unique([businessId, code])
  @@index([businessId, status])
  @@index([businessId, departmentId])
  @@index([businessId, name])
}

model PayComponent {
  id                 String                    @id @default(cuid())
  businessId         String
  business           Business                  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name               String
  kind               PayComponentKind
  calcType           PayCalcType               @default(FIXED)
  defaultValue       Decimal                   @default(0) @db.Decimal(14, 2) // amount, or % for percentage types
  ruleKey            String? // calcType RULE: the registered rule
  appliesTo          PayrollKind               @default(REGULAR)
  accountId          String? // EARNING / EMPLOYER: expense ledger; DEDUCTION: ledger credited
  account            Account?                  @relation("PayComponentAccount", fields: [accountId], references: [id])
  liabilityAccountId String? // EMPLOYER: liability credited (PF payable, gratuity payable ...)
  liabilityAccount   Account?                  @relation("PayComponentLiability", fields: [liabilityAccountId], references: [id])
  systemKey          String? // BASIC, OVERTIME, ABSENCE, ADVANCE, LOAN ... (automatic components)
  taxable            Boolean                   @default(true)
  isActive           Boolean                   @default(true)
  sortOrder          Int                       @default(100)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  employeeLines      EmployeeSalaryComponent[]
  payslipLines       PayslipLine[]

  @@unique([businessId, name])
  @@unique([businessId, systemKey])
  @@index([businessId, kind])
}

/// One line of the salary structure of an employee (besides basic salary).
model EmployeeSalaryComponent {
  id          String       @id @default(cuid())
  employeeId  String
  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  componentId String
  component   PayComponent @relation(fields: [componentId], references: [id])
  calcType    PayCalcType
  value       Decimal      @db.Decimal(14, 2)

  @@unique([employeeId, componentId])
  @@index([componentId])
}

/// Salary structure history: a snapshot every time basic salary or structure changes.
model SalaryRevision {
  id            String   @id @default(cuid())
  businessId    String
  employeeId    String
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime
  basicSalary   Decimal  @db.Decimal(14, 2)
  structure     Json // [{ component, kind, calcType, value }]
  note          String?
  createdById   String
  createdAt     DateTime @default(now())

  @@index([employeeId, effectiveFrom])
  @@index([businessId])
}

model Attendance {
  id            String           @id @default(cuid())
  businessId    String
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime
  status        AttendanceStatus
  overtimeHours Decimal          @default(0) @db.Decimal(6, 2)
  lateMinutes   Int              @default(0)
  note          String?
  updatedById   String?
  updatedAt     DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([businessId, date])
}

model PayrollRun {
  id              String        @id @default(cuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  year            Int
  month           Int // 1-12
  kind            PayrollKind   @default(REGULAR)
  status          PayrollStatus @default(DRAFT)
  postingDate     DateTime
  workingDays     Int
  totalGross      Decimal       @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal       @default(0) @db.Decimal(14, 2)
  totalNet        Decimal       @default(0) @db.Decimal(14, 2)
  totalEmployer   Decimal       @default(0) @db.Decimal(14, 2)
  voucherId       String?       @unique
  voucher         Voucher?      @relation("PayrollRunVoucher", fields: [voucherId], references: [id])
  note            String?
  createdById     String
  postedById      String?
  postedAt        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  payslips        Payslip[]

  @@unique([businessId, year, month, kind])
  @@index([businessId, status])
}

model Payslip {
  id                 String          @id @default(cuid())
  businessId         String
  runId              String
  run                PayrollRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee        @relation(fields: [employeeId], references: [id])
  year               Int
  month              Int
  kind               PayrollKind
  // employee details as they were for this month
  employeeCode       String
  employeeName       String
  designation        String?
  departmentName     String?
  basicSalary        Decimal         @db.Decimal(14, 2)
  workingDays        Decimal         @db.Decimal(6, 2)
  payableDays        Decimal         @db.Decimal(6, 2)
  presentDays        Decimal         @default(0) @db.Decimal(6, 2)
  absentDays         Decimal         @default(0) @db.Decimal(6, 2)
  leaveDays          Decimal         @default(0) @db.Decimal(6, 2)
  unpaidLeaveDays    Decimal         @default(0) @db.Decimal(6, 2)
  halfDays           Decimal         @default(0) @db.Decimal(6, 2)
  lateDays           Decimal         @default(0) @db.Decimal(6, 2)
  holidays           Decimal         @default(0) @db.Decimal(6, 2)
  deductedDays       Decimal         @default(0) @db.Decimal(6, 2)
  overtimeHours      Decimal         @default(0) @db.Decimal(8, 2)
  extraOvertimeHours Decimal         @default(0) @db.Decimal(8, 2) // entered at review, on top of attendance
  overtimeRate       Decimal         @default(0) @db.Decimal(14, 2)
  gross              Decimal         @db.Decimal(14, 2)
  totalDeductions    Decimal         @db.Decimal(14, 2)
  net                Decimal         @db.Decimal(14, 2)
  employerCost       Decimal         @default(0) @db.Decimal(14, 2)
  paidAmount         Decimal         @default(0) @db.Decimal(14, 2)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  lines              PayslipLine[]
  payments           SalaryPayment[]

  @@unique([employeeId, year, month, kind]) // one payslip per employee, month and kind: no duplicate payroll
  @@index([businessId, year, month])
  @@index([runId])
}

model PayslipLine {
  id                 String           @id @default(cuid())
  payslipId          String
  payslip            Payslip          @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  componentId        String?
  component          PayComponent?    @relation(fields: [componentId], references: [id])
  advanceId          String?
  advance            EmployeeAdvance? @relation(fields: [advanceId], references: [id])
  kind               PayComponentKind
  name               String
  amount             Decimal          @db.Decimal(14, 2)
  accountId          String
  account            Account          @relation("PayslipLineAccount", fields: [accountId], references: [id])
  liabilityAccountId String?
  liabilityAccount   Account?         @relation("PayslipLineLiability", fields: [liabilityAccountId], references: [id])
  isManual           Boolean          @default(false) // added at review (bonus, fine ...), kept on recalculation
  note               String?
  sortOrder          Int              @default(0)

  @@index([payslipId])
  @@index([advanceId])
  @@index([componentId])
}

model EmployeeAdvance {
  id            String        @id @default(cuid())
  businessId    String
  employeeId    String
  employee      Employee      @relation(fields: [employeeId], references: [id])
  kind          AdvanceKind
  date          DateTime
  amount        Decimal       @db.Decimal(14, 2)
  installment   Decimal       @db.Decimal(14, 2) // recovered per payroll
  voucherId     String        @unique
  voucher       Voucher       @relation("PayrollAdvanceVoucher", fields: [voucherId], references: [id])
  note          String?
  createdById   String
  createdAt     DateTime      @default(now())
  recoveryLines PayslipLine[]

  @@index([businessId, employeeId])
}

/// Salary paid to an employee, allocated to a payslip; one payment voucher may pay many employees.
model SalaryPayment {
  id          String   @id @default(cuid())
  businessId  String
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  payslipId   String
  payslip     Payslip  @relation(fields: [payslipId], references: [id])
  voucherId   String
  voucher     Voucher  @relation("SalaryPaymentVoucher", fields: [voucherId], references: [id], onDelete: Cascade)
  date        DateTime
  amount      Decimal  @db.Decimal(14, 2)
  createdById String
  createdAt   DateTime @default(now())

  @@index([businessId, employeeId])
  @@index([businessId, date])
  @@index([voucherId])
  @@index([payslipId])
}

// ───────────────────────── Feature & module management ─────────────────────────
// Catalogue of optional modules (mirrors src/lib/features.ts), per-business on/off state,
// the permissions each module uses, and an activation log. Switching a feature off never
// deletes the module's data — it only closes access.

enum FeatureTier {
  FREE
  PAID
}

enum FeatureStatus {
  AVAILABLE
  COMING_SOON
}

enum FeatureLogAction {
  ENABLED
  DISABLED
}

model Feature {
  key            String                 @id // e.g. HRM, PRODUCT_EXPIRY
  nameBn         String
  nameEn         String
  descriptionBn  String
  descriptionEn  String
  icon           String
  tier           FeatureTier            @default(FREE)
  status         FeatureStatus          @default(AVAILABLE)
  defaultEnabled Boolean                @default(true)
  sortOrder      Int                    @default(0)
  updatedAt      DateTime               @updatedAt
  businesses     BusinessFeature[]
  permissions    FeaturePermission[]
  logs           FeatureActivationLog[]
  plans          PlanFeature[]
}

/// A business's choice for a feature; no row = the feature's default.
model BusinessFeature {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  featureKey    String
  feature       Feature   @relation(fields: [featureKey], references: [key])
  enabled       Boolean
  changedById   String?
  changedAt     DateTime  @default(now())
  adminOverride Boolean? // super admin: true = always allowed, false = always blocked, null = plan decides
  overrideById  String?
  overrideAt    DateTime?

  @@unique([businessId, featureKey])
}

/// Which permission keys grant which action (VIEW, CREATE, EDIT, DELETE, EXPORT, APPROVE) in a module.
model FeaturePermission {
  id         String  @id @default(cuid())
  featureKey String
  feature    Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)
  action     String
  permission String
  owned      Boolean @default(false) // used only by this module: blocked while it is off

  @@unique([featureKey, action, permission])
}

model FeatureActivationLog {
  id         String           @id @default(cuid())
  businessId String
  business   Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  featureKey String
  feature    Feature          @relation(fields: [featureKey], references: [key])
  action     FeatureLogAction
  userId     String
  note       String?
  createdAt  DateTime         @default(now())

  @@index([businessId, createdAt])
}

// ───────────────────────── SaaS: plans, subscriptions, billing ─────────────────────────
// A Business is the tenant. Its Subscription decides which features it may use (Plan → PlanFeature);
// the company admin switches entitled features on/off (BusinessFeature). Payments go through a
// provider-neutral PaymentTransaction; a verified payment becomes a SubscriptionPayment with an
// Invoice and extends the subscription. Everything is configured in the database, not in code.

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  EXPIRING // derived for display (ends within the reminder window); stored status stays ACTIVE/TRIAL
  EXPIRED
  CANCELLED // will not renew; access until the end of the paid period
  SUSPENDED // blocked by the platform
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  INITIATED // checkout created, customer not back yet
  PENDING // waiting for verification (manual transfer)
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum InvoiceStatus {
  UNPAID
  PAID
  VOID
  REFUNDED
}

/// Platform-wide billing settings (one row, id "platform").
model PlatformSetting {
  id               String   @id @default("platform")
  trialDays        Int      @default(14)
  trialPlanCode    String   @default("PREMIUM") // plan used during the free trial
  fallbackPlanCode String   @default("FREE") // what an expired subscription keeps (data is never deleted)
  graceDays        Int      @default(3) // access continues this many days after the end date
  reminderDays     Int[]    @default([7, 3, 1])
  vatPercent       Decimal  @default(0) @db.Decimal(5, 2)
  currency         String   @default("BDT")
  invoicePrefix    String   @default("BL")
  invoiceSeq       Int      @default(0)
  updatedAt        DateTime @updatedAt
}

model Plan {
  id            String               @id @default(cuid())
  code          String               @unique // FREE, BASIC, BUSINESS, PREMIUM …
  nameBn        String
  nameEn        String
  descriptionBn String?
  descriptionEn String?
  priceMonthly  Decimal              @default(0) @db.Decimal(12, 2)
  priceYearly   Decimal              @default(0) @db.Decimal(12, 2)
  userLimit     Int? // null = unlimited
  isActive      Boolean              @default(true) // can be chosen
  isPublic      Boolean              @default(true) // shown on the pricing page
  sortOrder     Int                  @default(0)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  features      PlanFeature[]
  subscriptions Subscription[]
  transactions  PaymentTransaction[]
  invoices      Invoice[]
}

model PlanFeature {
  planId     String
  plan       Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  featureKey String
  feature    Feature @relation(fields: [featureKey], references: [key], onDelete: Cascade)

  @@id([planId, featureKey])
}

/// The current subscription of a business (history: SubscriptionEvent, SubscriptionPayment, Invoice).
model Subscription {
  id            String                @id @default(cuid())
  businessId    String                @unique
  business      Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId        String
  plan          Plan                  @relation(fields: [planId], references: [id])
  status        SubscriptionStatus
  billingCycle  BillingCycle          @default(MONTHLY)
  startDate     DateTime
  endDate       DateTime? // null = does not end (free plan)
  trialEndsAt   DateTime?
  autoRenew     Boolean               @default(false)
  cancelledAt   DateTime?
  suspendedAt   DateTime?
  suspendReason String?
  /// price of the current paid period (null: trial / free / set by the platform without payment)
  amount        Decimal?              @db.Decimal(14, 2)
  /// status of the latest payment attempt for this subscription
  paymentStatus PaymentStatus?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  events        SubscriptionEvent[]
  payments      SubscriptionPayment[]

  @@index([status, endDate])
}

model SubscriptionEvent {
  id             String       @id @default(cuid())
  businessId     String
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  type           String // CREATED, TRIAL_STARTED, ACTIVATED, RENEWED, UPGRADED, DOWNGRADED, PLAN_CHANGED, EXTENDED, EXPIRED, SUSPENDED, RESUMED, CANCELLED, REMINDER …
  fromPlanCode   String?
  toPlanCode     String?
  fromStatus     String?
  toStatus       String?
  actorUserId    String?
  note           String?
  details        Json?
  createdAt      DateTime     @default(now())

  @@index([businessId, createdAt])
}

/// One payment attempt with a provider (bKash, Nagad, card, manual transfer, mock in development).
model PaymentTransaction {
  id                  String               @id @default(cuid())
  businessId          String
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId              String
  plan                Plan                 @relation(fields: [planId], references: [id])
  billingCycle        BillingCycle
  provider            String
  status              PaymentStatus        @default(INITIATED)
  amount              Decimal              @db.Decimal(12, 2) // total charged (incl. VAT)
  currency            String               @default("BDT")
  providerPaymentId   String? // gateway session / payment id
  providerTrxId       String? // gateway transaction id (unique per provider: no double use)
  manualReference     String? // TrxID / reference typed by the customer for a manual transfer
  failureReason       String?
  raw                 Json? // provider response, secrets removed
  initiatedById       String
  verifiedById        String? // super admin who verified a manual transfer
  completedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  subscriptionPayment SubscriptionPayment?

  @@unique([provider, providerTrxId])
  @@index([businessId, createdAt])
  @@index([status, createdAt])
}

/// A verified payment applied to the subscription (exactly one per successful transaction).
model SubscriptionPayment {
  id             String             @id @default(cuid())
  businessId     String
  subscriptionId String
  subscription   Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  transactionId  String             @unique
  transaction    PaymentTransaction @relation(fields: [transactionId], references: [id])
  invoiceId      String             @unique
  invoice        Invoice            @relation(fields: [invoiceId], references: [id])
  amount         Decimal            @db.Decimal(12, 2)
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime
  createdAt      DateTime           @default(now())

  @@index([businessId, paidAt])
}

model Invoice {
  id                  String               @id @default(cuid())
  number              String               @unique
  businessId          String
  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  planId              String
  plan                Plan                 @relation(fields: [planId], references: [id])
  billingCycle        BillingCycle
  periodStart         DateTime
  periodEnd           DateTime
  subtotal            Decimal              @db.Decimal(12, 2)
  discount            Decimal              @default(0) @db.Decimal(12, 2)
  vatPercent          Decimal              @default(0) @db.Decimal(5, 2)
  vatAmount           Decimal              @default(0) @db.Decimal(12, 2)
  total               Decimal              @db.Decimal(12, 2)
  status              InvoiceStatus        @default(PAID)
  paymentMethod       String?
  transactionRef      String? // gateway / transfer transaction id shown on the invoice
  paidAt              DateTime?
  billTo              Json // company snapshot (name, address, mobile, BIN/TIN)
  createdAt           DateTime             @default(now())
  subscriptionPayment SubscriptionPayment?

  @@index([businessId, createdAt])
}

// ───────────────────────────── production (BOM / recipes) ─────────────────────────────

enum ProductionLineKind {
  INPUT
  OUTPUT
}

/// Bill of materials: raw materials consumed and products obtained for one reference batch
/// (e.g. 100 kg paddy → 65 kg rice, 20 kg husk, 8 kg bran, 5 kg broken rice). Output costShare (%)
/// splits the batch cost between the main product and its by-products.
model Recipe {
  id          String          @id @default(cuid())
  businessId  String
  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  lines       RecipeLine[]
  runs        ProductionRun[]

  @@unique([businessId, name])
  @@index([businessId])
}

model RecipeLine {
  id        String             @id @default(cuid())
  recipeId  String
  recipe    Recipe             @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId String
  product   Product            @relation(fields: [productId], references: [id])
  kind      ProductionLineKind
  quantity  Decimal            @db.Decimal(14, 3) // base unit, per reference batch
  costShare Decimal            @default(0) @db.Decimal(7, 4) // outputs only: % of the batch cost
  lineNo    Int                @default(0)

  @@index([recipeId])
  @@index([productId])
}

/// A production entry (voucher type PRODUCTION): materials out, products in, costs allocated.
model ProductionRun {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  voucherId  String   @unique
  voucher    Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  recipeId   String?
  recipe     Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)
  batches    Decimal  @default(1) @db.Decimal(14, 4) // multiples of the recipe's reference batch
  extraCost  Decimal  @default(0) @db.Decimal(14, 2) // labour, power… added to the products' cost
  createdAt  DateTime @default(now())

  @@index([businessId])
  @@index([recipeId])
}

/// Paddy purchase details (rice mill weighbridge slip) of a PURCHASE voucher:
///   net = gross − dhalta (manual deduction, kg) · mon = net ÷ 40 (2 dp) · total = mon × rate per mon.
/// Depot delivery challan (one per voucher).
///   COMPANY_PAID      voucher type DEPOT_DELIVERY: stock out at moving-average cost against the company's
///                     account; commission (Σ line amount = quantity × commission rate) is posted
///                     Dr "কমিশন প্রাপ্য — <company>" / Cr "ডিপো কমিশন আয়". No dealer due.
///   DEPOT_COLLECTION  voucher type SALES to the dealer: stock out, sale, cash or market due.
model DepotDelivery {
  id               String            @id @default(cuid())
  businessId       String
  business         Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  voucherId        String            @unique
  voucher          Voucher           @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  mode             DepotDeliveryMode
  companyAccountId String? // the company (supplier ledger) whose DO is delivered
  companyAccount   Account?          @relation("DepotCompany", fields: [companyAccountId], references: [id])
  dealerAccountId  String? // the dealer (customer ledger) receiving the goods
  dealerAccount    Account?          @relation("DepotDealer", fields: [dealerAccountId], references: [id])
  doNumber         String? // company DO / release order number
  vehicleNo        String?
  driverName       String?
  notes            String?
  commissionTotal  Decimal           @default(0) @db.Decimal(14, 2)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([businessId])
  @@index([companyAccountId])
  @@index([dealerAccountId])
}

/// The voucher line is in মণ (quantity = mon, rate = rate per mon → amount = total exactly) while the
/// stock receives the exact net kg. bagCount is information for the slip only (no calculation).
model PaddyPurchase {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  voucherId  String   @unique
  voucher    Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  bagCount   Int      @default(0) // bag_count — shown first on the slip, not used in any calculation
  grossKg    Decimal  @db.Decimal(14, 3) // gross_scale
  dhaltaKg   Decimal  @default(0) @db.Decimal(14, 3) // dhalta — manual deduction in kg
  netKg      Decimal  @db.Decimal(14, 3) // net_scale = gross − dhalta
  mon        Decimal  @db.Decimal(14, 2) // net ÷ 40
  ratePerMon Decimal  @db.Decimal(14, 2) // rate_per_mon
  totalPrice Decimal  @db.Decimal(14, 2) // mon × rate_per_mon
  notes      String? // vehicle number, driver, remarks
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([businessId])
}
